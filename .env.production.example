# Copy to .env.production on the server and fill in. Never commit the filled-in file.
# Generate secrets with: openssl rand -base64 48

# ---- Domain and HTTPS ----
SITE_DOMAIN=foundura.org
ACME_EMAIL=you@your-domain
# Image version to run. Empty follows main; or the first 12 characters of a commit to pin or roll back.
FOUNDURA_TAG=
SITE_URL=https://foundura.org
CORS_ORIGINS=https://foundura.org

# ---- Database ----
# Postgres runs on this server (docker-compose.selfdb.yml). Its password: openssl rand -hex 24
POSTGRES_PASSWORD=
# Leave empty. Only if you later move to a managed database (e.g. DigitalOcean): its private connection
# string ending with ?sslmode=verify-full&sslrootcert=/certs/db-ca.crt, with the CA certificate saved as
# deploy/certs/db-ca.crt. See DEPLOY.md.
DATABASE_URL=
# Postgres tools image the backup scripts use with a managed database; at least the cluster's major version.
PG_TOOLS_IMAGE=postgres:17-alpine

# ---- API secrets ----
JWT_SECRET=
ADMIN_API_KEY=
# Editors who can open /admin (comma-separated)
ADMIN_EMAILS=

# ---- Email (Zoho ZeptoMail, India data centre; add and verify foundura.org there: SPF and DKIM records) ----
# Sign-in codes, weekly scheme alerts and ops alerts go out through ZeptoMail. Mailboxes (support@, grievance@)
# are separate, in Zoho Mail.
OTP_DELIVERY=email
# Mail Agents → your agent → SMTP/API → API → Send Mail token
ZEPTOMAIL_TOKEN=
OTP_FROM_EMAIL="Foundura <login@foundura.org>"

# ---- Who runs Foundura, shown on /privacy and /terms (required by the DPDP Act and IT Rules) ----
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_JURISDICTION_CITY=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_EMAIL=grievance@foundura.org
SUPPORT_EMAIL=support@foundura.org

# ---- Scheduled emails: weekly scheme alerts (Mondays 8:00 IST) and the yearly terms reminder ----
SCHEDULED_EMAILS=true
# Read editors' event sources (calendar feeds and organiser pages) once a day from 6:00 India time.
EVENT_SYNC=true
# Where server errors and stalled scheduled jobs are emailed. Use an inbox someone reads.
OPS_ALERT_EMAIL=
# Random secret (32+ characters) the web server uses to report its errors to the API: openssl rand -hex 24
OPS_REPORT_TOKEN=

# ---- Backups (deploy/backup.sh daily, deploy/restore-drill.sh monthly; see DEPLOY.md section 6) ----
# Alert if either stops succeeding. Turn on once both are in the server's crontab.
BACKUP_CHECK=true
# Days of dumps kept on the server. 6 with DigitalOcean's daily backups (kept 7 days), so deleted accounts
# leave every backup within the 14 days the privacy notice promises.
KEEP_DAYS=6
# Optional extra off-site copy through rclone, e.g. foundura-offsite:foundura-backups. Empty is fine:
# DigitalOcean's daily backups already keep the server, dumps included, off the server.
BACKUP_REMOTE=
