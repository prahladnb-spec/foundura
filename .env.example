# ---------- API (apps/api) ----------
DATABASE_URL="postgresql://foundura:foundura@localhost:5432/foundura?schema=public"
API_PORT=4000
# Long random string; used to sign session tokens
JWT_SECRET="change-me-to-a-long-random-string"
# Comma-separated origins allowed to call the API
CORS_ORIGINS="http://localhost:3000"
# Key for admin CSV imports (events, policy). Long random string.
ADMIN_API_KEY="change-me-admin-key"
# Emails allowed into /admin after signing in (comma-separated)
ADMIN_EMAILS=""
# Scheduled emails: weekly scheme alerts (Mondays 8:00 IST) and the yearly terms reminder
SCHEDULED_EMAILS="false"
# Public site URL used in notification emails
SITE_URL="http://localhost:3000"
# "dev" returns one-time codes in the API response for local testing; "email" sends them (configure RESEND_API_KEY)
OTP_DELIVERY="dev"
RESEND_API_KEY=""
OTP_FROM_EMAIL="Foundura <login@example.com>"

# ---------- Web (apps/web) ----------
# Where the web server reaches the API
API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
