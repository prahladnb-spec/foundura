{
  "name": "@foundura/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch-path=dist dist/src/main.js)",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env db/seed.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed:prod": "node dist/db/seed.js"
  },
  "dependencies": {
    "@foundura/shared": "workspace:*",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/throttler": "6.8.0",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.11",
    "@swc/core": "^1.7.0",
    "@types/express": "^5.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^4.1.12"
  }
}
